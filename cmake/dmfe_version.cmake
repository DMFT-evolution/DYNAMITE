# Writes the Git state of the source tree into a header at build time, so that the
# program reports the version it was built from (and not that of the directory it
# is started from).  Called on every build by the target dmfe_version_stamp; the
# header is only rewritten when its content changes, so an unchanged Git state does
# not trigger recompilation.
#
# Input variables: SRC (source directory), OUT (header to write), FALLBACK (version
# used when the source is not a Git checkout, e.g. a release archive).

find_package(Git QUIET)

function(dmfe_git out_var)
    set(${out_var} "unknown" PARENT_SCOPE)
    if(GIT_FOUND)
        execute_process(COMMAND "${GIT_EXECUTABLE}" ${ARGN}
                        WORKING_DIRECTORY "${SRC}"
                        RESULT_VARIABLE rc
                        OUTPUT_VARIABLE out
                        ERROR_QUIET
                        OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(rc EQUAL 0 AND NOT out STREQUAL "")
            set(${out_var} "${out}" PARENT_SCOPE)
        endif()
    endif()
endfunction()

dmfe_git(git_hash    rev-parse HEAD)
dmfe_git(git_branch  rev-parse --abbrev-ref HEAD)
dmfe_git(git_tag     describe --tags --exact-match)
dmfe_git(git_version describe --tags --always --dirty)
dmfe_git(git_status  status --porcelain --untracked-files=no)

if(git_hash STREQUAL "unknown")
    set(git_dirty 0)
    set(code_version "v${FALLBACK}")
else()
    if(git_status STREQUAL "unknown")
        set(git_dirty 0)
    else()
        set(git_dirty 1)
    endif()
    set(code_version "${git_version}")
endif()

set(content "// Generated by cmake/dmfe_version.cmake at build time. Do not edit.
#pragma once
#define DMFE_GIT_HASH \"${git_hash}\"
#define DMFE_GIT_BRANCH \"${git_branch}\"
#define DMFE_GIT_TAG \"${git_tag}\"
#define DMFE_GIT_DIRTY ${git_dirty}
#define DMFE_CODE_VERSION \"${code_version}\"
")

if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
else()
    set(old "")
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUT}" "${content}")
endif()

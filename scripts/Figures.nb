Cell[BoxData[{
 RowBox[{
  RowBox[{"pos", "=", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"bsearch", "[", 
     RowBox[{"t1grid", ",", 
      SuperscriptBox["2", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"-", "10"}], ",", "22", ",", ".05"}], "]"}]]}], "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Rmin", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Min", "[", "#", "]"}], "&"}], "/@", 
    RowBox[{
     RowBox[{"data", "[", 
      RowBox[{"\"\<Data\>\"", ",", "\"\<QRv\>\""}], "]"}], "[", 
     RowBox[{"[", "pos", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Rfunc", "[", "t_", "]"}], "=", 
   RowBox[{
    RowBox[{"Interpolation", "[", 
     RowBox[{
      RowBox[{"Developer`ToPackedArray", "[", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"t1grid", "[", 
           RowBox[{"[", "pos", "]"}], "]"}], ",", "Rmin"}], "}"}], "]"}], 
       "]"}], ",", 
      RowBox[{"Method", "->", "\"\<Spline\>\""}], ",", 
      RowBox[{"InterpolationOrder", "->", "5"}]}], "]"}], "[", "t", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Rfunc2", "[", "t_", "]"}], "=", 
   RowBox[{
    RowBox[{"Interpolation", "[", 
     RowBox[{
      RowBox[{"Developer`ToPackedArray", "[", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"t1grid", "[", 
           RowBox[{"[", "pos", "]"}], "]"}], ",", 
          RowBox[{"LowpassFilter", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"t1grid", "[", 
                RowBox[{"[", "pos", "]"}], "]"}], " ", 
               RowBox[{
                SuperscriptBox["Rfunc", "\[Prime]"], "[", 
                RowBox[{"t1grid", "[", 
                 RowBox[{"[", "pos", "]"}], "]"}], "]"}]}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Rfunc", "[", 
                RowBox[{"t1grid", "[", 
                 RowBox[{"[", "pos", "]"}], "]"}], "]"}], "-", "0"}], ")"}]}],
             ",", ".1"}], "]"}]}], "}"}], "]"}], "]"}], ",", 
      RowBox[{"Method", "->", "\"\<Spline\>\""}], ",", 
      RowBox[{"InterpolationOrder", "->", "5"}]}], "]"}], "[", "t", "]"}]}], 
  ";"}]}], "Input",

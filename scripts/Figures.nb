Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "Int\[Theta]3", ",", "Int\[Theta]5", ",", "sectionInt", ",", "diff", ",", 
    "splineCoeffs"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Int\[Theta]3", ":=", 
   RowBox[{
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"Accumulate", "[", 
       RowBox[{"#", " ", ".", " ", "secInt3"}], "]"}], ",", "0"}], "]"}], 
    "&"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Int\[Theta]5", ":=", 
   RowBox[{
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"Accumulate", "[", 
       RowBox[{"#", " ", ".", " ", "secInt5"}], "]"}], ",", "0"}], "]"}], 
    "&"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"diff", ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"Rest", "[", "#", "]"}], "-", 
      RowBox[{"Most", "[", "#", "]"}]}], "&"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sectionInt", "[", 
     RowBox[{"{", 
      RowBox[{"points_", ",", 
       RowBox[{"prec_", ":", "MachinePrecision"}]}], "}"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "interp3", ",", "interp5", ",", "I1", ",", "I2", ",", "d\[Omega]", ",",
         "pts"}], "}"}], ",", "\n", 
      RowBox[{
       RowBox[{"pts", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{"points", ",", "prec"}], "]"}]}], ";", "\n", 
       RowBox[{"d\[Omega]", "=", 
        RowBox[{"diff", "[", "pts", "]"}]}], ";", "\n", 
       RowBox[{"(*", 
        RowBox[{"Cubic", " ", "interpolation"}], " ", "*)"}], "\n", 
       RowBox[{"interp3", "=", 
        RowBox[{"splineCoeffs", "[", 
         RowBox[{"{", 
          RowBox[{"pts", ",", "0", ",", "prec", ",", "0"}], "}"}], "]"}]}], 
       ";", "\n", 
       RowBox[{"(*", 
        RowBox[{"quintic", " ", "interpolation"}], " ", "*)"}], "\n", 
       RowBox[{"interp5", "=", 
        RowBox[{"splineCoeffs", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"pts", ",", "0", ",", "prec", ",", "0"}], "}"}], ",", 
          RowBox[{"\"\<Five\>\"", "->", "True"}]}], "]"}]}], ";", "\n", 
       RowBox[{"(*", 
        RowBox[{
        "integrate", " ", "over", " ", "each", " ", "interval", " ", "with", 
         " ", "two", " ", "different", " ", "\"\<weight\>\"", " ", 
         "functions"}], "*)"}], "\n", 
       RowBox[{"(*", 
        RowBox[{"Integrate", "[", 
         RowBox[{
          RowBox[{"x", "^", "m"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "0", ",", "a"}], "}"}]}], "]"}], "*)"}], "\n", 
       RowBox[{"I1", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"1", "/", 
            RowBox[{"(", 
             RowBox[{"#", "+", "1"}], ")"}]}], " ", 
           RowBox[{"Power", "[", 
            RowBox[{"d\[Omega]", ",", 
             RowBox[{"#", "+", "1"}]}], "]"}]}], "&"}], "/@", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", "5"}], "]"}]}]}], ";", "\n", 
       RowBox[{"(*", 
        RowBox[{"FullSimplify", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Integrate", "[", 
            RowBox[{
             RowBox[{"x", "^", 
              RowBox[{"mSin", "[", 
               RowBox[{"2", "\[Pi]", " ", 
                RowBox[{"x", "/", "a"}]}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "0", ",", "a"}], "}"}], ",", 
             RowBox[{"Assumptions", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"m", "\[GreaterEqual]", "0"}], ",", 
                RowBox[{"m", "\[Element]", "Integers"}], ",", 
                RowBox[{"a", ">", "0"}]}], "}"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", "0", ",", "5"}], "}"}]}], "]"}], "]"}], "*)"}], 
       "\n", 
       RowBox[{"(*", 
        RowBox[{
        "Build", " ", "and", " ", "output", " ", "inteval", " ", 
         "integration", " ", "matrices"}], "*)"}], "\n", 
       RowBox[{"Chop", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{"I1", "[", 
               RowBox[{"[", 
                RowBox[{";;", "4"}], "]"}], "]"}], " ", "interp3"}], "]"}], 
            "]"}], ",", 
           RowBox[{"Transpose", "[", 
            RowBox[{"Total", "[", 
             RowBox[{"I1", " ", "interp5"}], "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"10", "^", 
          RowBox[{"-", "20"}]}]}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SyntaxInformation", "[", "splineCoeffs", "]"}], "=", 
   RowBox[{"{", 

Cell[BoxData[{
 RowBox[{
  RowBox[{"bsearch", "=", 
   RowBox[{"Compile", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"list", ",", "_Complex", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"elem", ",", "_Real"}], "}"}]}], "}"}], ",", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n0", "=", "1"}], ",", 
         RowBox[{"n1", "=", 
          RowBox[{"Length", "[", "list", "]"}]}], ",", 
         RowBox[{"m", "=", "0"}], ",", "diff1"}], "}"}], ",", 
       RowBox[{
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"n0", "<=", "n1"}], ",", 
          RowBox[{
           RowBox[{"m", "=", 
            RowBox[{"Quotient", "[", 
             RowBox[{
              RowBox[{"n0", "+", "n1"}], ",", "2"}], "]"}]}], ";", "\n", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"list", "[", 
               RowBox[{"[", "m", "]"}], "]"}], "==", "elem"}], ",", 
             RowBox[{"Return", "[", "m", "]"}]}], "]"}], ";", "\n", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"list", "[", 
               RowBox[{"[", "m", "]"}], "]"}], "<", "elem"}], ",", 
             RowBox[{"n0", "=", 
              RowBox[{"m", "+", "1"}]}], ",", 
             RowBox[{"n1", "=", 
              RowBox[{"m", "-", "1"}]}]}], "]"}]}]}], "]"}], ";", "\n", 
        RowBox[{"diff1", "=", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"list", "[", 
            RowBox[{"[", "m", "]"}], "]"}], "-", "elem"}], "]"}]}], ";", "\n", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"list", "[", 
            RowBox[{"[", "m", "]"}], "]"}], "<", "elem"}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"diff1", "<=", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"list", "[", 
                RowBox[{"[", 
                 RowBox[{"Min", "[", 
                  RowBox[{
                   RowBox[{"m", "+", "1"}], ",", 
                   RowBox[{"Length", "[", "list", "]"}]}], "]"}], "]"}], 
                "]"}], "-", "elem"}], "]"}]}], ",", "m", ",", 
            RowBox[{"m", "+", "1"}]}], "]"}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"diff1", "<=", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"list", "[", 
                RowBox[{"[", 
                 RowBox[{"Max", "[", 
                  RowBox[{
                   RowBox[{"m", "-", "1"}], ",", "1"}], "]"}], "]"}], "]"}], 
               "-", "elem"}], "]"}]}], ",", "m", ",", 
            RowBox[{"m", "-", "1"}]}], "]"}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"RuntimeAttributes", "->", 
      RowBox[{"{", "Listable", "}"}]}], ",", 

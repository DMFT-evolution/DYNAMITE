Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"plot", "=", 
  RowBox[{"LogLogPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"Efunc", "[", "x", "]"}], "-", "Eth"}], "]"}], ",", 
      RowBox[{
       FractionBox["1", "2"], 
       SuperscriptBox["x", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]], 
       RowBox[{"HeavisideTheta", "[", 
        RowBox[{"x", "-", "0.1"}], "]"}], 
       RowBox[{"HeavisideTheta", "[", 
        RowBox[{"1000", "-", "x"}], "]"}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", ".01", ",", 
      RowBox[{"t1grid", "[", 
       RowBox[{"[", 
        RowBox[{"-", "1"}], "]"}], "]"}]}], "}"}], ",", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Directive", "[", 
        RowBox[{"Red", ",", "Thick"}], "]"}], ",", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "Dashed", ",", "Thick"}], "]"}]}], "}"}]}], ",", 
    RowBox[{"PlotRange", "->", "Full"}], ",", 
    RowBox[{"Evaluate", "[", "style", "]"}], ",", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"MaTeX", "[", 
        RowBox[{"\"\<t\>\"", ",", 
         RowBox[{"Magnification", "\[Rule]", "2.5"}]}], "]"}], ",", 
       RowBox[{"MaTeX", "[", 
        RowBox[{"\"\<E(t)-E_\\\\text{th}\>\"", ",", 
         RowBox[{"Magnification", "\[Rule]", "2.5"}]}], "]"}]}], "}"}]}], ",", 
    RowBox[{"Epilog", "->", 
     RowBox[{"Inset", "[", 
      RowBox[{
       RowBox[{"MaTeX", "[", 
        RowBox[{"\"\<\\\\sim t^{-1/2}\>\"", ",", 
         RowBox[{"Magnification", "\[Rule]", "2"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"1.85", ",", 
         RowBox[{"-", "0.45"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"\[CapitalGamma]", ",", "c", ",", "g", ",", "\[Mu]"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalGamma]", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", "t"}], ")"}]}], " ", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{"k", " ", 
       RowBox[{"BesselI", "[", 
        RowBox[{"k", ",", 
         RowBox[{"4", " ", "t"}]}], "]"}], 
       SuperscriptBox["T", 
        RowBox[{"k", "-", "1"}]]}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "0", ",", "50"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"d\[CapitalGamma]", "[", "t_", "]"}], "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"\[CapitalGamma]", "[", "t", "]"}], "]"}], ",", "t"}], 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c", "[", 
    RowBox[{
     RowBox[{"t_", "?", "NumberQ"}], ",", 
     RowBox[{"t1_", "?", "NumberQ"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"\[CapitalGamma]", "[", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{"t", ",", "40"}], "]"}], "]"}], " ", 
       RowBox[{"\[CapitalGamma]", "[", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{"t1", ",", "40"}], "]"}], "]"}]}], "]"}]}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"BesselI", "[", 
        RowBox[{"1", ",", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{"t", "+", "t1"}], ")"}]}], ",", "40"}], "]"}]}], "]"}], 
       "/", 
       RowBox[{"(", 
        RowBox[{"t", "+", "t1"}], ")"}]}], "+", 
      RowBox[{"2", " ", "T", " ", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[CapitalGamma]", "[", "\[Tau]", "]"}], " ", 
          RowBox[{
           RowBox[{"BesselI", "[", 
            RowBox[{"1", ",", 
             RowBox[{"2", " ", 
              RowBox[{"(", 
               RowBox[{"t", "+", "t1", "-", 
                RowBox[{"2", " ", "\[Tau]"}]}], ")"}]}]}], "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"t", "+", "t1", "-", 
             RowBox[{"2", " ", "\[Tau]"}]}], ")"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Tau]", ",", "0", ",", "t1"}], "}"}]}], "]"}]}]}], 
     ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"t_", ",", "t1_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"\[CapitalGamma]", "[", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{"t1", ",", "40"}], "]"}], "]"}], "/", 
      RowBox[{"\[CapitalGamma]", "[", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{"t", ",", "40"}], "]"}], "]"}]}], "]"}], " ", 
    RowBox[{
     RowBox[{"BesselI", "[", 
      RowBox[{"1", ",", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"t", "-", "t1"}], ")"}], "+", 
            SuperscriptBox["10", 
             RowBox[{"-", "40"}]]}], ")"}]}], ",", "40"}], "]"}]}], "]"}], 
     "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"t", "-", "t1"}], ")"}], "+", 
       SuperscriptBox["10", 
        RowBox[{"-", "40"}]]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Mu]", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"2", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"c", "[", 
         RowBox[{"t", ",", "s"}], "]"}], " ", 
        RowBox[{"g", "[", 
         RowBox[{"t", ",", "s"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", "0", ",", "t"}], "}"}]}], "]"}]}], "+", "T"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"e", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "2"}], 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"c", "[", 
        RowBox[{"t", ",", "s"}], "]"}], " ", 
       RowBox[{"g", "[", 
        RowBox[{"t", ",", "s"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "0", ",", "t"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eana", "[", "t_", "]"}], "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{"T", "-", 
      RowBox[{"d\[CapitalGamma]", "[", "t", "]"}]}], ")"}]}]}], 
  ";"}]}], "Input",

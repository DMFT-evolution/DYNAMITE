       RowBox[{"InterpolationOrder", "->", "3"}]}], "]"}], "[", "x", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"QLog", "[", 
    RowBox[{"t_", ",", "x_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Interpolation", "[", 
     RowBox[{
      RowBox[{"DeleteDuplicatesBy", "[", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Subdivide", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Log", "[", 
                 RowBox[{"QK", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}], "]"}], "-", 
                "0.001"}], ",", 
               RowBox[{"Log", "[", 
                RowBox[{"QK", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"bsearch", "[", 
                    RowBox[{"t1grid", ",", "t"}], "]"}], ",", "1"}], "]"}], 
                 "]"}], "]"}], ",", "10"}], "]"}], ",", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "11"}], "]"}]}], "}"}], "]"}], ",", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Log", "[", 
               RowBox[{"QK", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"bsearch", "[", 
                   RowBox[{"t1grid", ",", "t"}], "]"}], ",", "1"}], "]"}], 
                "]"}], "]"}], "-", 
              RowBox[{"Log", "[", 
               RowBox[{"QK", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"bsearch", "[", 
                   RowBox[{"t1grid", ",", 
                    RowBox[{"t", " ", "\[Theta]points"}]}], "]"}], ",", "1"}],
                  "]"}], "]"}], "]"}]}], ",", 
             RowBox[{"QK", "[", 
              RowBox[{"[", 
               RowBox[{"bsearch", "[", 
                RowBox[{"t1grid", ",", "t"}], "]"}], "]"}], "]"}]}], "}"}], 
           "]"}]}], "]"}], ",", "First"}], "]"}], ",", 
      RowBox[{"Method", "->", "\"\<Spline\>\""}], ",", 
      RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", "x", "]"}]}], 
  ";"}]}], "Input",

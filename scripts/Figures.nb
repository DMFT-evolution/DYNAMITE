          RowBox[{"(", 
           RowBox[{"1", "/", "4"}], ")"}], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Omega]2", "-", "\[Omega]1"}], ")"}], "^", "4"}]}]}], 
        ";", "\n", 
        RowBox[{
         RowBox[{"f4", "[", 
          RowBox[{"\[Omega]1_", ",", "\[Omega]2_"}], "]"}], ":=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "/", "5"}], ")"}], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Omega]2", "-", "\[Omega]1"}], ")"}], "^", "5"}]}]}], 
        ";", "\n", 
        RowBox[{
         RowBox[{"f5", "[", 
          RowBox[{"\[Omega]1_", ",", "\[Omega]2_"}], "]"}], ":=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "/", "6"}], ")"}], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Omega]2", "-", "\[Omega]1"}], ")"}], "^", "6"}]}]}], 
        ";", "\n", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<Five\>\"", "]"}], ",", 
          RowBox[{"IL6jk", "=", 
           RowBox[{"SetPrecision", "[", 
            RowBox[{
             RowBox[{"{", 

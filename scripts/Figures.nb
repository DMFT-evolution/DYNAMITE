Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"hfunc", ",", "Q"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hfunc", "[", 
    RowBox[{"t_", ",", "t2_", ",", 
     RowBox[{"\[Alpha]_", ":", "1"}]}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tpos", "=", 
        RowBox[{"bsearch", "[", 
         RowBox[{"t1grid", ",", "t"}], "]"}]}], ",", "dataH"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"QKinter", "[", "\[Theta]_", "]"}], "=", 
       RowBox[{
        RowBox[{"Interpolation", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"\[Theta]points", ",", 
             RowBox[{"QK", "[", 
              RowBox[{"[", "tpos", "]"}], "]"}]}], "}"}], "]"}], ",", 
          RowBox[{"Method", "->", "\"\<Spline\>\""}], ",", 
          RowBox[{"InterpolationOrder", "->", "3"}]}], "]"}], "[", "\[Theta]",
         "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"dQKinter", "[", "\[Theta]_", "]"}], "=", 
       RowBox[{
        RowBox[{"Interpolation", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"\[Theta]points", ",", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"QK", "[", 
                 RowBox[{"[", 
                  RowBox[{"tpos", "+", "1"}], "]"}], "]"}], "-", 
                RowBox[{"QK", "[", 
                 RowBox[{"[", "tpos", "]"}], "]"}]}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"t1grid", "[", 
                 RowBox[{"[", 
                  RowBox[{"tpos", "+", "1"}], "]"}], "]"}], "-", 
                RowBox[{"t1grid", "[", 
                 RowBox[{"[", "tpos", "]"}], "]"}]}], ")"}]}]}], "}"}], "]"}],
           ",", 
          RowBox[{"Method", "->", "\"\<Spline\>\""}], ",", 
          RowBox[{"InterpolationOrder", "->", "3"}]}], "]"}], "[", "\[Theta]",
         "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"dataH", "=", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Alpha]"}], " ", 
         RowBox[{"Reverse", "[", 
          RowBox[{"Prepend", "[", 
           RowBox[{
            RowBox[{"Accumulate", "[", 
             RowBox[{
              RowBox[{"Reverse", "[", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"-", 
                   RowBox[{"(", 
                    FractionBox[
                    RowBox[{
                    SuperscriptBox["QKinter", "\[Prime]"], "[", "\[Theta]", 
                    "]"}], "t"], ")"}]}], "/", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"dQKinter", "[", "\[Theta]", "]"}], "-", 
                    RowBox[{
                    FractionBox["\[Theta]", "t"], 
                    RowBox[{
                    SuperscriptBox["QKinter", "\[Prime]"], "[", "\[Theta]", 
                    "]"}]}]}], ")"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"\[Theta]", ",", "\[Theta]points"}], "}"}]}], "]"}],
                "]"}], ".", "secInt5"}], "]"}], ",", "0"}], "]"}], "]"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Interpolation", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"t", " ", "\[Theta]points"}], ",", "dataH"}], "}"}], 
          "]"}], ",", 
         RowBox[{"Method", "->", "\"\<Spline\>\""}], ",", 
         RowBox[{"InterpolationOrder", "->", "3"}]}], "]"}], "[", "t2", 
       "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Q", "[", 
     RowBox[{"t_", ",", "x_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Interpolation", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
